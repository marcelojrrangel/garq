<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Garq Explorer</title>
  <style>
    :root { color-scheme: dark; }
    body { margin: 0; font-family: Segoe UI, Arial, sans-serif; background: #111318; color: #eef2f7; }
    .layout { display: grid; grid-template-columns: 320px 1fr 360px; height: 100vh; }
    .pane { border-right: 1px solid #2a2f3a; overflow: auto; }
    .pane:last-child { border-right: none; }
    .head { padding: 10px 12px; background: #171b23; border-bottom: 1px solid #2a2f3a; font-weight: 600; }
    .body { padding: 10px; }
    .tree ul { list-style: none; margin: 0; padding-left: 14px; }
    .tree-row { display: flex; align-items: center; gap: 6px; padding: 4px 6px; border-radius: 6px; cursor: pointer; }
    .tree-row:hover { background: #1d2330; }
    .tree-row.active { background: #2b6ef6; }
    .toggle { width: 18px; text-align: center; color: #8da2c2; cursor: pointer; }
    .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid #2a2f3a; }
    tr:hover { background: #1b202b; }
    .pathbar { padding: 8px 10px; border-bottom: 1px solid #2a2f3a; font-size: 12px; color: #a6b0bf; }
    input, button, textarea { width: 100%; box-sizing: border-box; border-radius: 6px; border: 1px solid #3a4252; background: #121723; color: #eef2f7; padding: 8px; margin-bottom: 8px; }
    button { background: #2b6ef6; border: none; cursor: pointer; font-weight: 600; }
    button.secondary { background: #2a2f3a; }
    .list { background: #121723; border: 1px solid #2a2f3a; border-radius: 8px; padding: 8px; max-height: 170px; overflow: auto; }
    select.list { width: 100%; height: 170px; color: #eef2f7; font-family: inherit; font-size: 12px; outline: none; box-sizing: border-box; margin-bottom: 8px; }
    select.list option { padding: 4px 6px; border-radius: 4px; margin-bottom: 2px; }
    select.list option:checked { background: #2b6ef6; color: #ffffff; }
    .list-item { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 6px; font-size: 12px; }
    .tag { display: inline-block; font-size: 11px; padding: 2px 6px; border-radius: 999px; background: #2a2f3a; }
    .ok { color: #53d769; } .fail { color: #ff5d5d; } .run { color: #ffcc00; }

    /* Progress Modal Premium Styling */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(8, 10, 15, 0.8);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      animation: fadeIn 0.3s ease-out;
    }
    .modal-card {
      background: #171b23;
      border: 1px solid #2a2f3a;
      border-radius: 12px;
      width: 480px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-header {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #eef2f7;
    }
    .modal-body {
      margin-bottom: 20px;
    }
    .progress-bar-track {
      background: #121723;
      border: 1px solid #2a2f3a;
      height: 12px;
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 8px;
      position: relative;
    }
    .progress-bar-fill {
      background: linear-gradient(90deg, #2b6ef6, #00d2ff);
      height: 100%;
      width: 0%;
      border-radius: 6px;
      transition: width 0.3s cubic-bezier(0.1, 0.8, 0.1, 1);
    }
    .progress-status-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: #a6b0bf;
    }
    .modal-footer button {
      margin-bottom: 0;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="layout">
    <div class="pane">
      <div class="head">Explorer - Unidades e Pastas</div>
      <div class="body tree">
        <ul id="roots"></ul>
      </div>
    </div>

    <div class="pane">
      <div class="head">Arquivos e Pastas</div>
      <div class="pathbar" id="current-path">Selecione uma pasta na árvore...</div>
      <div class="body">
        <button class="secondary" id="btn-use-current-dest">Usar pasta atual como destino</button>
        <table>
          <thead>
            <tr><th></th><th>Nome</th><th>Tipo</th><th>Tamanho</th><th>Modificado</th><th></th></tr>
          </thead>
          <tbody id="dir-body"></tbody>
        </table>
      </div>
    </div>

    <div class="pane">
      <div class="head">Fila avançada + Jobs</div>
      <div class="body">
        <h4>Selecionados para cópia</h4>
        <select class="list" id="selected-list" multiple></select>
        <button class="secondary" id="btn-add-checked">Adicionar marcados</button>
        <button class="secondary" id="btn-clear-selected">Limpar seleção</button>

        <label>Destino cópia (pasta)</label>
        <input id="copy-dest" placeholder="E:\destino" />
        <button id="btn-copy-job">Criar job de cópia</button>

        <h4>Compactação (7z) dos selecionados</h4>
        <input id="compress-dest" placeholder="arquivo .7z destino" />
        <button id="btn-compress-job">Criar job de compactação</button>

        <h4>Extração (7z)</h4>
        <input id="extract-archive" placeholder="arquivo .7z" />
        <input id="extract-dest" placeholder="pasta destino" />
        <button id="btn-extract-job">Criar job de extração</button>

        <h4>Jobs</h4>
        <button class="secondary" id="btn-refresh-jobs">Atualizar jobs</button>
        <div class="list" id="jobs-list"></div>
      </div>
    </div>
  </div>

  <!-- Modal de Progresso -->
  <div id="progress-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <span id="modal-job-title">Executando Operação...</span>
      </div>
      <div class="modal-body">
        <div class="progress-container">
          <div class="progress-bar-track">
            <div id="modal-progress-fill" class="progress-bar-fill"></div>
          </div>
          <div class="progress-status-row">
            <span id="modal-progress-text">0%</span>
            <span id="modal-status-badge" class="tag">pendente</span>
          </div>
        </div>
        <div id="modal-error-message" class="fail" style="display: none; margin-top: 12px; font-size: 13px; white-space: pre-wrap; overflow-wrap: break-word;"></div>
      </div>
      <div class="modal-footer" id="modal-footer" style="display: none;">
        <button id="btn-close-modal" class="secondary">Fechar</button>
      </div>
    </div>
  </div>

  <script>
    const api = () => window.go?.api?.API;
    let currentPath = "";
    let currentEntries = [];
    const selectedSources = new Set();
    const expanded = new Set();

    function statusClass(status) {
      if (status === "done") return "ok";
      if (status === "failed") return "fail";
      if (status === "running") return "run";
      return "";
    }

    function esc(s) {
      return String(s).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
    }

    async function loadRoots() {
      const roots = await api().ListRoots();
      const ul = document.getElementById("roots");
      ul.innerHTML = "";
      roots.forEach((root) => {
        const li = document.createElement("li");
        li.appendChild(buildTreeNode(root, root, true));
        ul.appendChild(li);
      });
    }

    function buildTreeNode(path, label, isRoot = false) {
      const wrapper = document.createElement("div");
      const row = document.createElement("div");
      row.className = "tree-row";
      row.dataset.path = path;

      const toggle = document.createElement("span");
      toggle.className = "toggle";
      toggle.textContent = expanded.has(path) ? "▼" : "▶";
      row.appendChild(toggle);

      const name = document.createElement("span");
      name.className = "name";
      name.textContent = isRoot ? `💽 ${label}` : `📁 ${label}`;
      row.appendChild(name);
      wrapper.appendChild(row);

      const children = document.createElement("ul");
      children.style.display = expanded.has(path) ? "block" : "none";
      wrapper.appendChild(children);

      toggle.onclick = async (e) => {
        e.stopPropagation();
        if (expanded.has(path)) {
          expanded.delete(path);
          children.style.display = "none";
          toggle.textContent = "▶";
          return;
        }
        expanded.add(path);
        toggle.textContent = "▼";
        children.style.display = "block";
        if (!children.dataset.loaded) {
          await loadTreeChildren(path, children);
          children.dataset.loaded = "1";
        }
      };

      row.onclick = async () => {
        document.querySelectorAll(".tree-row.active").forEach(el => el.classList.remove("active"));
        row.classList.add("active");
        await openDirectory(path);
      };
      return wrapper;
    }

    async function loadTreeChildren(parentPath, ul) {
      ul.innerHTML = "";
      const entries = await api().ListDirectory(parentPath);
      entries.filter(e => e.is_dir).forEach((e) => {
        const li = document.createElement("li");
        li.appendChild(buildTreeNode(e.path, e.name));
        ul.appendChild(li);
      });
    }

    async function openDirectory(path) {
      currentPath = path;
      document.getElementById("current-path").textContent = path;
      currentEntries = await api().ListDirectory(path);
      const tbody = document.getElementById("dir-body");
      tbody.innerHTML = "";
      currentEntries.forEach((e, idx) => {
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${e.is_dir ? "" : `<input type="checkbox" class="file-check" data-idx="${idx}">`}</td>
          <td>${e.is_dir ? "📁 " : "📄 "}${esc(e.name)}</td>
          <td>${e.is_dir ? "Pasta" : "Arquivo"}</td>
          <td>${e.is_dir ? "-" : e.size}</td>
          <td>${esc(e.mod_time)}</td>
          <td>${e.is_dir ? `<button class="secondary" data-open="${idx}">Abrir</button>` : `<button class="secondary" data-add="${idx}">Adicionar</button>`}</td>
        `;
        tbody.appendChild(tr);
      });

      tbody.querySelectorAll("button[data-open]").forEach((btn) => {
        btn.onclick = async () => {
          const e = currentEntries[Number(btn.dataset.open)];
          await openDirectory(e.path);
        };
      });
      tbody.querySelectorAll("button[data-add]").forEach((btn) => {
        btn.onclick = () => {
          const e = currentEntries[Number(btn.dataset.add)];
          selectedSources.add(e.path);
          renderSelected();
        };
      });
    }

    function renderSelected() {
      const list = document.getElementById("selected-list");
      list.innerHTML = "";
      [...selectedSources].forEach((p) => {
        const opt = document.createElement("option");
        opt.value = p;
        opt.textContent = p;
        list.appendChild(opt);
      });
    }

    async function refreshJobs() {
      const jobs = await api().GetJobs();
      const out = document.getElementById("jobs-list");
      out.innerHTML = "";
      jobs.forEach((j) => {
        const div = document.createElement("div");
        div.className = "list-item";
        div.innerHTML = `<span>#${j.id} <span class="tag">${j.type}</span> <span class="${statusClass(j.status)}">${j.status} ${Math.round((j.progress || 0) * 100)}%</span></span><span>${esc(j.updated_at)}</span>`;
        out.appendChild(div);
      });
    }

    document.getElementById("btn-add-checked").onclick = () => {
      document.querySelectorAll(".file-check:checked").forEach((chk) => {
        const e = currentEntries[Number(chk.dataset.idx)];
        if (e && !e.is_dir) selectedSources.add(e.path);
      });
      renderSelected();
    };

    document.getElementById("btn-clear-selected").onclick = () => {
      selectedSources.clear();
      renderSelected();
    };

    function getDirectoryPath(path) {
      path = path.trim();
      if (!path) return "";
      const lastSlashIdx = Math.max(path.lastIndexOf("\\"), path.lastIndexOf("/"));
      if (lastSlashIdx === -1) return path;
      const lastSegment = path.substring(lastSlashIdx + 1);
      if (lastSegment.includes(".")) {
        return path.substring(0, lastSlashIdx);
      }
      return path;
    }

    function initDestInputs() {
      const savedDest = localStorage.getItem("last_dest_dir");
      if (savedDest) {
        document.getElementById("copy-dest").value = savedDest;
        document.getElementById("compress-dest").value = savedDest + (savedDest.endsWith("\\") || savedDest.endsWith("/") ? "" : "\\") + "compactado.7z";
        document.getElementById("extract-dest").value = savedDest;
      }
    }

    document.getElementById("btn-use-current-dest").onclick = () => {
      if (currentPath) {
        document.getElementById("copy-dest").value = currentPath;
        document.getElementById("compress-dest").value = currentPath + (currentPath.endsWith("\\") || currentPath.endsWith("/") ? "" : "\\") + "compactado.7z";
        document.getElementById("extract-dest").value = currentPath;
        localStorage.setItem("last_dest_dir", currentPath);
      }
    };

    function getJobTitle(type) {
      if (type === "copy") return "Copiando Arquivos";
      if (type === "compress") return "Compactando Arquivos (7z)";
      if (type === "extract") return "Extraindo Arquivos (7z)";
      return "Processando";
    }

    function translateStatus(status) {
      if (status === "pending") return "pendente";
      if (status === "running") return "executando";
      if (status === "done") return "concluído";
      if (status === "failed") return "falhou";
      return status;
    }

    function trackJob(jobId, type) {
      // Abre o modal e limpa o estado anterior
      document.getElementById("progress-modal").style.display = "flex";
      document.getElementById("modal-job-title").textContent = getJobTitle(type) + " (Job #" + jobId + ")";
      document.getElementById("modal-progress-fill").style.width = "0%";
      document.getElementById("modal-progress-text").textContent = "0%";
      
      const badge = document.getElementById("modal-status-badge");
      badge.textContent = "pendente";
      badge.className = "tag run";
      
      document.getElementById("modal-error-message").style.display = "none";
      document.getElementById("modal-error-message").textContent = "";
      document.getElementById("modal-footer").style.display = "none";

      const intervalId = setInterval(async () => {
        try {
          const jobs = await api().GetJobs();
          const job = jobs.find(j => j.id === jobId);
          if (!job) return;

          const pct = Math.round((job.progress || 0) * 100);
          document.getElementById("modal-progress-fill").style.width = pct + "%";
          document.getElementById("modal-progress-text").textContent = pct + "%";

          badge.textContent = translateStatus(job.status);
          badge.className = "tag " + statusClass(job.status);

          if (job.status === "done") {
            clearInterval(intervalId);
            setTimeout(() => {
              document.getElementById("progress-modal").style.display = "none";
            }, 600);
            refreshJobs();
          } else if (job.status === "failed") {
            clearInterval(intervalId);
            const errMsg = document.getElementById("modal-error-message");
            errMsg.textContent = job.error || "Ocorreu um erro desconhecido no processamento.";
            errMsg.style.display = "block";
            document.getElementById("modal-footer").style.display = "block";
            refreshJobs();
          }
        } catch (e) {
          console.error("Erro ao atualizar progresso:", e);
        }
      }, 300);
    }

    document.getElementById("btn-close-modal").onclick = () => {
      document.getElementById("progress-modal").style.display = "none";
    };

    document.getElementById("btn-copy-job").onclick = async () => {
      const dest = document.getElementById("copy-dest").value.trim();
      localStorage.setItem("last_dest_dir", getDirectoryPath(dest));
      try {
        const jobId = await api().AddCopyJob([...selectedSources], dest);
        trackJob(jobId, "copy");
      } catch (err) {
        alert("Erro ao iniciar cópia: " + err);
      }
    };

    document.getElementById("btn-compress-job").onclick = async () => {
      const dest = document.getElementById("compress-dest").value.trim();
      localStorage.setItem("last_dest_dir", getDirectoryPath(dest));
      try {
        const jobId = await api().AddCompressJob([...selectedSources], dest);
        trackJob(jobId, "compress");
      } catch (err) {
        alert("Erro ao iniciar compactação: " + err);
      }
    };

    document.getElementById("btn-extract-job").onclick = async () => {
      const archive = document.getElementById("extract-archive").value.trim();
      const dest = document.getElementById("extract-dest").value.trim();
      localStorage.setItem("last_dest_dir", getDirectoryPath(dest));
      try {
        const jobId = await api().AddExtractJob(archive, dest);
        trackJob(jobId, "extract");
      } catch (err) {
        alert("Erro ao iniciar extração: " + err);
      }
    };

    document.getElementById("btn-refresh-jobs").onclick = refreshJobs;

    document.getElementById("selected-list").addEventListener("keydown", (e) => {
      if (e.key === "Delete" || e.key === "Del") {
        let changed = false;
        Array.from(e.target.selectedOptions).forEach((opt) => {
          selectedSources.delete(opt.value);
          changed = true;
        });
        if (changed) {
          renderSelected();
        }
      }
    });

    setInterval(refreshJobs, 2000);
    loadRoots();
    refreshJobs();
    initDestInputs();
  </script>
</body>
</html>
